<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.detalle.FragmentoDetallePelicula">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contenidoDetalle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imagenFondo"
                android:layout_width="0dp"
                android:layout_height="@dimen/alto_fondo"
                android:background="?attr/colorSurfaceVariant"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/degradado_fondo"
                app:layout_constraintBottom_toBottomOf="@id/imagenFondo"
                app:layout_constraintEnd_toEndOf="@id/imagenFondo"
                app:layout_constraintStart_toStartOf="@id/imagenFondo"
                app:layout_constraintTop_toTopOf="@id/imagenFondo" />

            <Space
                android:id="@+id/anclaPoster"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="@dimen/superposicion_poster"
                app:layout_constraintBottom_toBottomOf="@id/imagenFondo"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjetaPoster"
                android:layout_width="@dimen/ancho_poster_detalle"
                android:layout_height="@dimen/alto_poster_detalle"
                android:layout_marginStart="@dimen/margen_horizontal_detalle"
                app:cardElevation="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/anclaPoster"
                app:shapeAppearance="@style/Forma.Seminario.Poster"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/imagenPosterDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/colorSurfaceVariant"
                    android:contentDescription="@string/poster_generico"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/bloqueEncabezado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="@dimen/margen_horizontal_detalle"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tarjetaPoster"
                app:layout_constraintTop_toBottomOf="@id/imagenFondo">

                <TextView
                    android:id="@+id/textoTituloDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    tools:text="Dune: Part Two" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textoPuntuacionDetalle"
                        style="@style/Widget.Seminario.EtiquetaPuntuacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="8.2 / 10" />

                    <TextView
                        android:id="@+id/textoVotosDetalle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="5,321 votes" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textoFechaEstrenoDetalle"
                    style="@style/Widget.Seminario.TextoDato"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:drawableStartCompat="@drawable/ic_calendario"
                    tools:text="February 27, 2024" />

                <TextView
                    android:id="@+id/textoDuracionDetalle"
                    style="@style/Widget.Seminario.TextoDato"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:drawableStartCompat="@drawable/ic_reloj"
                    tools:text="2 h 46 min" />
            </LinearLayout>

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barreraEncabezado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="tarjetaPoster,bloqueEncabezado" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupoGeneros"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margen_horizontal_detalle"
                android:layout_marginTop="20dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/barreraEncabezado" />

            <TextView
                android:id="@+id/textoEtiquetaSinopsis"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margen_horizontal_detalle"
                android:layout_marginTop="20dp"
                android:text="@string/sinopsis"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/grupoGeneros" />

            <TextView
                android:id="@+id/textoSinopsisDetalle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margen_horizontal_detalle"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textoEtiquetaSinopsis" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progresoDetalle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        app:trackCornerRadius="4dp" />

    <include
        android:id="@+id/vistaError"
        layout="@layout/vista_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
